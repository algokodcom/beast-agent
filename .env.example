# Beast Agent API keys example.
# Usage: copy this file to %APPDATA%\beast\.env and enter your keys.
# This file matches the key_env fields in config.yaml;
# if key_env is missing, <PROVIDER_ID>_API_KEY is tried (e.g. zhipu -> ZHIPU_API_KEY).

OPENCODE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# STT (speech → text) — Hermes STT engine. When a key is set, the local whisper is NOT used.
# Free key: console.groq.com — default engine: Groq whisper-large-v3-turbo
GROQ_API_KEY=
