<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ARKA PLAN YOKLAMASI: uygulama kapalıyken bildirim için alarm alıcısı -->
        <receiver
            android:name=".PollReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- SÜREKLİ BAĞLANTI + CANLI MOD: uygulama arka plandayken WebSocket
             ve mikrofon erişimi devam eder (Android 11+ microphone FGS tipi). -->
        <service
            android:name=".KeepService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SESLİ MESAJ: mikrofon kaydı -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- CANLI KONUŞMA: WebView getUserMedia (Capacitor izin köprüsü bunu ister) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- GELEN MESAJ BİLDİRİMİ (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- UYGULAMA KAPALIYKEN BİLDİRİM: periyodik alarm + yeniden açılış -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SÜREKLİ BAĞLANTI: arka planda WebSocket'i düşürmeyen ön plan servisi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- CANLI MOD ARKA PLAN: mikrofonlu ön plan servisi (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Canlı modda ekran kapalıyken de ses döngüsü çalışsın -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- AJAN DOSYALARI: telefona kaydedip açma -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
