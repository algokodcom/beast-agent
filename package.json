{
    "name": "beast-agent",
    "productName": "Beast Agent",
    "version": "0.30.0",
    "description": "Ultra-fast local agent shell for Windows.",
    "author": "algokodcom (AlgoKod)",
    "license": "MIT",
    "homepage": "https://github.com/algokodcom/beast-agent#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/algokodcom/beast-agent.git"
    },
    "bugs": {
        "url": "https://github.com/algokodcom/beast-agent/issues"
    },
    "keywords": [
        "agent",
        "ai",
        "whatsapp",
        "assistant",
        "electron",
        "windows",
        "llm",
        "openai"
    ],
    "main": "src/main.js",
    "bin": {
        "beast-agent": "bin/beast-agent.js",
        "beast": "bin/beast-agent.js"
    },
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win nsis portable",
        "test": "node --test \"tests/**/*.test.js\"",
        "release": "node scripts/release.js",
        "postinstall": "node scripts/fix-electron.js --soft",
        "prepublishOnly": "node scripts/swap-electron.js deps",
        "postpublish": "node scripts/swap-electron.js devdeps"
    },
    "devDependencies": {
        "electron-builder": "^26.15.3",
        "electron": "40.10.2"
    },
    "dependencies": {
        "@pdf-lib/fontkit": "^1.1.1",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "@xenova/transformers": "^2.17.2",
        "electron-updater": "^6.8.9",
        "ffmpeg-static": "^5.3.0",
        "imapflow": "^1.7.6",
        "nodemailer": "^9.0.5",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^2.4.5",
        "pdf-to-img": "^6.3.0",
        "pdfjs-dist": "^5.6.205",
        "pdfkit": "^0.20.1",
        "qrcode": "^1.5.4",
        "tesseract.js": "^7.0.0",
        "ws": "^8.21.3"
    },
    "build": {
        "appId": "com.quantumalgo.beastagent",
        "productName": "Beast Agent",
        "directories": {
            "output": "dist"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "algokodcom",
                "repo": "beast-agent"
            }
        ],
        "files": [
            "src/**/*",
            "assets/**/*",
            "!tests/**"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "assets/app.ico"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "createDesktopShortcut": "always",
            "runAfterFinish": true,
            "artifactName": "BeastAgent-Setup-${version}.exe"
        },
        "portable": {
            "artifactName": "BeastAgent.exe"
        },
        "asarUnpack": [
            "node_modules/ffmpeg-static/**",
            "node_modules/@xenova/transformers/**",
            "**/node_modules/@napi-rs/canvas/**",
            "**/node_modules/tesseract.js/**",
            "**/node_modules/tesseract.js-core/**"
        ]
    }
}
